  "home.games": {
   "value": [
    {
     "id": "colorMatch",
     "goal": "把相同颜色的色块凑到一起，清空棋盘。",
     "how": [
      "把一个色块拖到相邻的同色色块上：两个都会消失。",
      "拖进空格子，让色块滑得离它的同伴更近。"
     ],
     "harder": [
      "第 10 层起：墙壁，以及滑动次数有限的色块（为 0 时冻结）",
      "第 30 层起：每个色块都有滑动次数限制，最多 6 种颜色",
      "第 60 层起：锁住的色块，旁边发生配对时才会打开"
     ]
    },
    {
     "id": "pathDraw",
     "goal": "一笔画到旗子，手指不离开屏幕。",
     "how": [
      "从一个节点画到另一个节点；往回拉可撤销上一步。",
      "经过检查点，最后停在旗子上。手指离开屏幕，线条就会重置。"
     ],
     "harder": [
      "第 20 层起：迷雾，你只能看到笔尖周围",
      "第 30 层起：按顺序经过检查点",
      "第 60 层起：经过所有节点，墙壁更多"
     ]
    },
    {
     "id": "blockFit",
     "goal": "把每个拼块都放进棋盘的空隙里。",
     "how": [
      "把拼块从托盘拖到棋盘上；轻点拼块可以旋转它。",
      "轻点已放好的拼块可以取回；全部放好，这一层就完成了。"
     ],
     "harder": [
      "棋盘从 6×6 变成 8×8，拼块从 3 块变成 6 块",
      "第 30 层起：镜像拼块，长按可翻转",
      "拼块更大，空隙更紧"
     ]
    },
    {
     "id": "memory",
     "goal": "翻开卡牌，找出相同的牌。",
     "how": [
      "翻开两张牌：相同的会保持翻开，否则很快会再合上。",
      "记住每张牌的位置，找出所有成对的牌。"
     ],
     "harder": [
      "卡牌从 12 张增加到 24 张",
      "第 30 层起：三张一组，找出三张相同图案的牌",
      "翻错的牌合上得更快"
     ]
    },
    {
     "id": "flow",
     "goal": "连接相同颜色的两端，填满棋盘。",
     "how": [
      "从一个彩色圆点画线到同色的另一个圆点。",
      "线条不能交叉，每个格子都必须填满；手指离开屏幕时，没画完的线会消失。"
     ],
     "harder": [
      "棋盘从 5×5 变成 7×7",
      "颜色从 3 种增加到 6 种",
      "需要绕开的阻挡格子"
     ]
    },
    {
     "id": "pipes",
     "goal": "转动水管，让水流起来。",
     "how": [
      "轻点水管，把它旋转 90 度。",
      "把水从水源不间断地引到旗子；有水流过的水管会被填满。"
     ],
     "harder": [
      "第 40 层起：每根水管都必须接通",
      "分支更多，水管更乱",
      "第 100 层起使用 6×6 棋盘"
     ]
    },
    {
     "id": "colorSort",
     "goal": "整理颜色，直到每根试管只有一种颜色。",
     "how": [
      "轻点一根试管，再轻点另一根：顶部的颜色会倒过去。",
      "只能倒在相同颜色上或空试管里；卡住了？撤销。"
     ],
     "harder": [
      "颜色从 4 种增加到 8 种",
      "开局更混乱，解法更长",
      "始终有两根空试管：怎么规划由你决定"
     ]
    },
    {
     "id": "arrows",
     "goal": "按正确的顺序移出所有箭头。",
     "how": [
      "轻点一个箭头：它会朝箭头所指的方向滑动，身体跟在后面，如果前方畅通就会离开棋盘。",
      "如果被另一个箭头挡住，它会弹回来并损失 3 秒；先移走前面的箭头。"
     ],
     "harder": [
      "棋盘从 7×7 变成 11×11，最多填满 85%",
      "短箭头旁边是长达 12 格的蜿蜒长蛇",
      "更长的“先移这个”连锁"
     ]
    },
    {
     "id": "gates",
     "goal": "让每个方块都从同色的门离开。",
     "how": [
      "拖动方块：它只能沿箭头所指的方向滑动。前方畅通时，它会从同色的门离开；轻点一下就够了。",
      "第一步永远不会是直接离开：你必须先把一个方块停放到一旁，才能让出通路。"
     ],
     "harder": [
      "棋盘从 6×6 变成 8×8，方块从 7 个增加到 14 个",
      "每个棋盘至少需要 3 次、之后 4 次有计划的停放",
      "第 80 层起出现锁住的方块；第 100 层起出现可以朝任意方向滑动的 2×2 方块"
     ]
    },
    {
     "id": "flags",
     "goal": "在每行、每列和每个彩色区域各放一座瞭望塔。",
     "how": [
      "轻点一个格子：第一次是 ✕（标记），再点一次放上瞭望塔。每行、每列和每个区域都恰好需要一座。",
      "瞭望塔互不相邻，斜向也不行。每个棋盘都只有唯一解；不用猜，只靠逻辑。"
     ],
     "harder": [
      "棋盘从 6×6 变成 8×8",
      "前几个棋盘会帮你用圆点标出排除的格子；之后由你自己标记",
      "更长的推理链"
     ]
    },
    {
     "id": "lights",
     "goal": "点亮所有格子。",
     "how": [
      "轻点一个格子：它和上下左右的相邻格子（+ 形）都会翻转。暗的会亮，亮的会熄灭。",
      "按住手指可以看到哪些格子会翻转；斜向的格子不受影响。"
     ],
     "harder": [
      "棋盘从 3×3 变成 5×5",
      "解开需要的点击次数从 3 次增加到 10 次",
      "顺序很重要：先想，再点"
     ]
    }
   ],
