  "home.games_h2": {
   "value": "{puzzleTypes} 種謎題，一座高塔。",
   "state": "translated"
  },
  "home.games": {
   "value": [
    {
     "id": "colorMatch",
     "goal": "把相同的方塊湊在一起，清空盤面。",
     "how": [
      "把方塊拖到相鄰的同色方塊上：兩個都會消失。",
      "拖進空格，讓方塊滑向和它配對的方塊。"
     ],
     "harder": [
      "第 10 層起：牆壁，以及滑動次數有限的方塊（歸 0 時凍結）",
      "第 30 層起：每個方塊都有滑動次數上限，最多 6 種顏色",
      "第 60 層起：上鎖的方塊，旁邊發生配對時才會打開"
     ]
    },
    {
     "id": "pathDraw",
     "goal": "一筆畫到旗子，手指不離開螢幕。",
     "how": [
      "從節點畫到節點；往回拉可還原上一步。",
      "經過檢查點並停在旗子上。手指一離開，路線就會重設。"
     ],
     "harder": [
      "第 20 層起：霧氣，只看得到筆尖周圍",
      "第 30 層起：檢查點有順序",
      "第 60 層起：必須經過每個節點，牆壁更多"
     ]
    },
    {
     "id": "blockFit",
     "goal": "把每個拼塊放進盤面的空隙。",
     "how": [
      "把拼塊從托盤拖到盤面上；點一下拼塊可旋轉。",
      "點一下已放置的拼塊即可取回；全部放好時就過關。"
     ],
     "harder": [
      "盤面從 6×6 到 8×8，拼塊從 3 個到 6 個",
      "第 30 層起：鏡像拼塊，長按即可翻轉",
      "更大的拼塊，更窄的空隙"
     ]
    },
    {
     "id": "memory",
     "goal": "翻開卡片，找出相同的卡片。",
     "how": [
      "翻開兩張卡片：相同就保持翻開，否則很快會再蓋上。",
      "記住每張卡片的位置，找出所有成對的卡片。"
     ],
     "harder": [
      "卡片從 12 張到 24 張",
      "第 30 層起：三張一組，找出三張相同的圖案",
      "翻錯的卡片會更快蓋上"
     ]
    },
    {
     "id": "flow",
     "goal": "把相同顏色的端點連起來，填滿盤面。",
     "how": [
      "從一個彩色圓點畫線到同色的圓點。",
      "線不能交叉，每一格都必須填滿；手指一離開，未完成的線就會消失。"
     ],
     "harder": [
      "盤面從 5×5 到 7×7",
      "顏色從 3 種到 6 種",
      "必須繞過的封鎖格子"
     ]
    },
    {
     "id": "pipes",
     "goal": "轉動水管，讓水流起來。",
     "how": [
      "點一下水管，可將它旋轉 90 度。",
      "讓水從水源毫無缺口地流到旗子；有水流過的水管會被注滿。"
     ],
     "harder": [
      "第 40 層起：每一段水管都必須接上",
      "更多分支，水管更錯綜複雜",
      "第 100 層起是 6×6 盤面"
     ]
    },
    {
     "id": "colorSort",
     "goal": "把顏色分類，直到每支試管只裝一種顏色。",
     "how": [
      "點一支試管，再點另一支：最上層的顏色就會倒過去。",
      "只能倒在相同顏色上或倒進空試管；卡住了？還原。"
     ],
     "harder": [
      "顏色從 4 種到 8 種",
      "起始更混雜，解法更長",
      "永遠有兩支空試管：怎麼規劃由你決定"
     ]
    },
    {
     "id": "arrows",
     "goal": "按照正確的順序清除箭頭。",
     "how": [
      "點一下箭頭：它會朝箭頭所指的方向滑動，身體跟著移動，若前方暢通就會離開盤面。",
      "如果被另一個箭頭擋住，它會彈回來並扣 3 秒；先清除擋在前面的箭頭。"
     ],
     "harder": [
      "盤面從 7×7 到 11×11，最多填滿 85%",
      "短箭頭旁邊有最長 12 格的蜿蜒長蛇",
      "更長的「先移這個」連鎖"
     ]
    },
    {
     "id": "gates",
     "goal": "讓每個方塊都從同色的閘門離開。",
     "how": [
      "拖動方塊：它只能朝箭頭所指的方向滑動。路線暢通時，它會從同色閘門離開；點一下就夠了。",
      "第一步絕不會是出口：你必須先把一個方塊停到旁邊，才能讓出路來。"
     ],
     "harder": [
      "盤面從 6×6 到 8×8，方塊從 7 個到 14 個",
      "每個盤面至少需要 3 次、之後 4 次預先規劃的停放",
      "第 80 層起有上鎖的方塊；第 100 層起有可朝任何方向滑動的 2×2 方塊"
     ]
    },
    {
     "id": "flags",
     "goal": "在每一列、每一行和每個彩色區塊各放一座瞭望塔。",
     "how": [
      "點一下格子：第一次是 ✕（筆記），再點一次就是瞭望塔。每一列、每一行和每個區塊都必須剛好有一座。",
      "瞭望塔不能相鄰，斜對角也不行。每個盤面都只有唯一解；不用猜，只靠邏輯。"
     ],
     "harder": [
      "盤面從 6×6 到 8×8",
      "前幾個盤面會用圓點幫你標出被排除的格子；之後要自己標記",
      "更長的推理鏈"
     ]
    },
    {
     "id": "lights",
     "goal": "點亮每一格。",
     "how": [
      "點一下格子：它和它上、下、左、右的相鄰格子（+ 形）會翻轉。暗的會亮起，亮的會變暗。",
      "按住手指可看到哪些格子會翻轉；斜對角不受影響。"
     ],
     "harder": [
      "盤面從 3×3 到 5×5",
      "需要點 3 到 10 次才能解開",
      "順序很重要：先想，再點"
     ]
    }
   ],
